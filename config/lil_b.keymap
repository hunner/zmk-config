/*
 * lil-B - 20-key taipo keyboard
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <zmk-helpers/helper.h>

/*                              20 KEY MATRIX / LAYOUT MAPPING (lil-B)

  ╭─────────────────╮ ╭─────────────────╮ ╭─────────────────╮ ╭─────────────────╮
  │  0   1   2   3  │ │  4   5   6   7  │ │ LT4 LT3 LT2 LT1 │ │ RT1 RT2 RT3 RT4 │
  │  8   9  10  11  │ │ 12  13  14  15  │ │ LM4 LM3 LM2 LM1 │ │ RM1 RM2 RM3 RM4 │
  ╰───╮ 16  17 ╭────╯ ╰────╮ 18  19 ╭───╯ ╰───╮ LH1 LH0 ╭───╯ ╰───╮ RH0 RH1 ╭───╯
      ╰────────╯           ╰────────╯         ╰─────────╯         ╰─────────╯ */

// Left hand top row (pinky to index)
#define LT4  0
#define LT3  1
#define LT2  2
#define LT1  3

// Right hand top row (index to pinky)
#define RT1  4
#define RT2  5
#define RT3  6
#define RT4  7

// Left hand middle row (pinky to index)
#define LM4  8
#define LM3  9
#define LM2 10
#define LM1 11

// Right hand middle row (index to pinky)
#define RM1 12
#define RM2 13
#define RM3 14
#define RM4 15

// Thumbs: inner then outer for left, outer then inner for right
#define LH1 16
#define LH0 17
#define RH0 18
#define RH1 19

#undef TAIPO
#undef TAIPO_INNER
#undef TAIPO_OUTER
#define TAIPO 0
#define TAIPO_INNER 1
#define TAIPO_OUTER 2
#define TAIPO_THUMB_ORDER_OIIO 1
#define TAIPO_MODS_SACG 1
#include <zmk-taipo/taipo.dtsi>
#include <zmk-taipo/features/virtual_thumbs.dtsi>

#include "mouse.dtsi"

#define MOUSE 3
#define BLUETOOTH 4

ZMK_LAYER(taipo,
    // ╭─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────╮
         &none         &none         &none         &none             &none         &none         &none         &none
    // ├─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┤
         &none         &none         &none         &none             &none         &none         &none         &none
    // ╰─────────────┼─────────────┼─────────────┼─────────────╯   ╰─────────────┼─────────────┼─────────────┼─────────────╯
                       &none         &none                                         &none         &none
    //               ╰─────────────┴─────────────╯                               ╰─────────────┴─────────────╯
)
ZMK_COMBO(tog_mouse, &tog MOUSE, LT1 LM2 LT3, TAIPO MOUSE, COMBO_TERM_FAST)
ZMK_COMBO(tog_bluetooth, &tog BLUETOOTH, LT1 LM2 LM3 LT4, TAIPO BLUETOOTH, COMBO_TERM_FAST)
ZMK_COMBO(mouse_left_thumbs, &mo MOUSE, LH0 LH1, TAIPO MOUSE, COMBO_TERM_FAST)
ZMK_COMBO(mouse_right_thumbs, &mo MOUSE, RH0 RH1, TAIPO MOUSE, COMBO_TERM_FAST)
ZMK_COMBO(mouse_inner_thumbs, &mo MOUSE, LH1 RH1, TAIPO MOUSE, COMBO_TERM_FAST)
ZMK_COMBO(mouse_outer_thumbs, &mo MOUSE, LH0 RH0, TAIPO MOUSE, COMBO_TERM_FAST)

ZMK_LAYER(inner,
    // ╭─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────╮
         &none         &none         &none         &none             &none         &none         &none         &none
    // ├─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┤
         &none         &none         &none         &none             &none         &none         &none         &none
    // ╰─────────────┼─────────────┼─────────────┼─────────────╯   ╰─────────────┼─────────────┼─────────────┼─────────────╯
                       &none         &none                                         &none         &none
    //               ╰─────────────┴─────────────╯                               ╰─────────────┴─────────────╯
)

ZMK_LAYER(outer,
    // ╭─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────╮
         &none         &none         &none         &none             &none         &none         &none         &none
    // ├─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┤
         &none         &none         &none         &none             &none         &none         &none         &none
    // ╰─────────────┼─────────────┼─────────────┼─────────────╯   ╰─────────────┼─────────────┼─────────────┼─────────────╯
                       &none         &none                                         &none         &none
    //               ╰─────────────┴─────────────╯                               ╰─────────────┴─────────────╯
)

ZMK_LAYER(mouse,
    // ╭─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────╮
         &msc SCRL_RIGHT &msc SCRL_UP &msc SCRL_DOWN &msc SCRL_LEFT  &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
    // ├─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┤
         &mmv MOVE_RIGHT &mmv MOVE_UP &mmv MOVE_DOWN &mmv MOVE_LEFT  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
    // ╰─────────────┼─────────────┼─────────────┼─────────────╯   ╰─────────────┼─────────────┼─────────────┼─────────────╯
                       &mkp LCLK     &mkp RCLK                                     &mkp RCLK     &mkp LCLK
    //               ╰─────────────┴─────────────╯                               ╰─────────────┴─────────────╯
)
ZMK_LAYER(bluetooth,
    // ╭─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────╮
         &soft_off     &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &soft_off
    // ├─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┤
         &none         &bt BT_SEL 5  &bt BT_SEL 4  &bt BT_SEL 3      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5  &none
    // ╰─────────────┼─────────────┼─────────────┼─────────────╯   ╰─────────────┼─────────────┼─────────────┼─────────────╯
                       &none         &none                                         &none         &none
    //               ╰─────────────┴─────────────╯                               ╰─────────────┴─────────────╯
)
//&soft_off {
//    hold-time-ms = <3000>;
//};
ZMK_COMBO(lclear_bt, &bt BT_CLR, LT4 LM4, BLUETOOTH, COMBO_TERM_FAST)
ZMK_COMBO(rclear_bt, &bt BT_CLR, RT4 RM4, BLUETOOTH, COMBO_TERM_FAST)

/* vim: set tw=180 ft=c: */
